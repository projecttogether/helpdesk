{
  "name": "@helpdesk/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local --import ./src/instrument.ts --clear-screen=false src/main.ts",
    "build": "node scripts/build.mjs && node ../../scripts/inject-debug-ids.mjs dist",
    "start": "node dist/main.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "APP_ROLE=migrate tsx --env-file-if-exists=../../.env.local src/main.ts",
    "cli": "tsx --env-file-if-exists=../../.env.local src/cli.ts",
    "worker": "APP_ROLE=worker tsx --env-file-if-exists=../../.env.local --import ./src/instrument.ts src/main.ts"
  },
  "dependencies": {
    "@helpdesk/shared": "*",
    "@hono/node-server": "2.1.9",
    "@sentry/node": "11.14.0",
    "better-auth": "1.7.26",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.1.1",
    "@types/nodemailer": "8.0.2"
  }
}
