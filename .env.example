# Local development. Copy to .env.local; `docker compose -f compose.dev.yaml
# up -d` starts PostgreSQL 18, Mailpit and a Keycloak with test users
# (password: helpdesk-dev; the list is in compose.dev.yaml).
# Every variable is described in docs/configuration.md.

# The web app's development server (npm run dev) on port 5173 passes /api to
# the server on port 3000; sign in at http://localhost:5173.
APP_URL=http://localhost:5173
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:55448/helpdesk
# Development only; production: openssl rand -base64 32 (both).
AUTH_SECRET=development-secret-development-secret
ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQta2V5LWRldmVsb3BtZW50LWtleSE=

OIDC_ISSUER=http://localhost:8102/realms/helpdesk
OIDC_CLIENT_ID=helpdesk
OIDC_CLIENT_SECRET=helpdesk-dev-client-secret
OIDC_PROVIDER_NAME=Keycloak

# Roles from Keycloak groups through the Admin API (the dev client has a
# service account). DIRECTORY=oidc reads the sign-in's groups claim instead.
DIRECTORY=keycloak
GROUP_REQUESTERS=/helpdesk/employees
GROUP_OPERATORS=/helpdesk/operators
GROUP_ADMINS=/helpdesk/admins
GROUP_SUPERADMINS=/helpdesk/superadmins

NODE_ENV=development
RUN_MIGRATIONS=true

# Production with compose.yaml: new secrets, URLs and sign-in values above,
# and optionally the image to run (docs/deployment.md): latest (default) or
# sha-<commit>.
# HELPDESK_IMAGE_TAG=latest
